NEXT_PUBLIC_MEZHER_PAY_ADDRESS=
NEXT_PUBLIC_MEZHER_PAY_DEPLOY_BLOCK=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional: merchant address for the landing page "Try the demo checkout" link.
NEXT_PUBLIC_DEMO_MERCHANT=
# Optional: extra team wallets (comma separated) that /proof never counts as outside.
NEXT_PUBLIC_TEAM_WALLETS=
# Server only. Never prefix with NEXT_PUBLIC_.
RELAYER_PRIVATE_KEY=
# Server only: funds /api/faucet with test BTC. A separate key from the relayer. Unset or empty answers faucet_empty.
FAUCET_PRIVATE_KEY=
# Optional, server only: wei per faucet claim. Default is collateral for the minimum Trove (1,800 MUSD plus fee and gas deposit) at 250%, plus 5% for price drift and gas.
FAUCET_CLAIM_WEI=
